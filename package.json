{
  "name": "portflow-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:client": "vite --mode development",
    "dev:server": "node --env-file=.env.development server/server.js",
    "staging:client": "vite --mode staging --port 5174",
    "staging:server": "node --env-file=.env.staging server/server.js",
    "postinstall": "npm rebuild sqlite3 --build-from-source",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "start:local": "node --env-file=.env.production server/server.js",
    "server": "node --env-file=.env.production server/server.js",
    "backup:db": "node server/backup-database.js",
    "backup:db:local": "node --env-file=.env.production server/backup-database.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14",
    "vite": "^8.0.0"
  }
}
