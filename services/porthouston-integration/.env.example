PORT=3010
PORT_HOUSTON_CLIENT_ID=
PORT_HOUSTON_CLIENT_SECRET=
PORT_HOUSTON_API_BASE_URL=https://api.america.naviscloudops.com/v3/

# Optional if Port Houston provides a token URL separate from API base.
PORT_HOUSTON_AUTH_URL=

# Optional webhook protection. Add the same value to the Port Houston webhook URL
# as ?secret=... or send it in x-porthouston-webhook-secret.
PORT_HOUSTON_WEBHOOK_SECRET=

# Optional subscription filters.
PORT_HOUSTON_TRUCKING_COMPANY_ID=
PORT_HOUSTON_BOOKING_NUMBER=
PORT_HOUSTON_STEAMSHIP_LINE=

# Optional if Port Houston gives a different document endpoint.
# Use {id} where the gate transaction nbr/gkey should be inserted.
PORT_HOUSTON_EIR_DOCUMENT_URL_PATTERN=

# Optional TMS callbacks. These let this service update Portflow and upload EIRs.
PORTFLOW_TMS_API_BASE_URL=
PORTFLOW_TMS_API_TOKEN=
PORTFLOW_TMS_EIR_UPLOAD_URL=
PORTFLOW_DISPATCH_ALERT_URL=
