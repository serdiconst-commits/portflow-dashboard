{
  "name": "portflow-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --mode development",
    "dev:client": "vite --mode development",
    "dev:server": "node --env-file=.env.development server/server.js",
    "staging:client": "vite --mode staging --port 5174",
    "staging:server": "node --env-file=.env.staging server/server.js",
    "build": "vite build",
    "build:driver": "vite build --mode driver",
    "mobile:sync": "npm run build:driver && npx cap sync",
    "mobile:android": "npm run build:driver && npx cap sync android && cd android && gradlew.bat bundleRelease",
    "mobile:android:mac": "npm run build:driver && npx cap sync android && cd android && ./gradlew bundleRelease",
    "mobile:ios": "npm run build:driver && npx cap sync ios && npx cap open ios",
    "preview": "vite preview",
    "start": "node server/server.js",
    "start:render": "npm rebuild sqlite3 --build-from-source && cd server && node server.js",
    "start:local": "node --env-file=.env.production server/server.js",
    "server": "node --env-file=.env.production server/server.js",
    "backup:db": "node server/backup-database.js",
    "backup:db:local": "node --env-file=.env.production server/backup-database.js"
  },
  "dependencies": {
    "@capgo/capacitor-document-scanner": "^8.3.29",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14",
    "vite": "^8.0.0"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "^1.2.4",
    "@img/sharp-linux-x64": "^0.34.5"
  }
}
